<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://github.com/rfsmason/immich-tv-for-samsung"
        version="0.1.0"
        viewmodes="maximized">
  <tizen:application id="imchTV0001.ImmichTV" package="imchTV0001" required_version="4.0" />
  <content src="index.html" />
  <access origin="*" subdomains="true" />
  <feature name="http://tizen.org/feature/screen.size.all" />
  <icon src="icon.png" />
  <name>Fotos</name>
  <description>Your private photo library on Samsung TV.</description>
  <author href="https://github.com/rfsmason">rfsmason</author>
  <tizen:profile name="tv-samsung" />
  <tizen:privilege name="http://tizen.org/privilege/internet" />
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice" />
  <tizen:setting pointing-device-support="disable" />
</widget>
